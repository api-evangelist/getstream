{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stream Chat API (Server-side REST) Application Threads API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Threads",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query threads",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://chat.stream-io-api.com/threads",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Query the threads a user participates in."
        },
        {
          "info": {
            "name": "Get a thread",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://chat.stream-io-api.com/threads/:message_id",
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path",
                "description": "The parent message id identifying the thread."
              }
            ]
          },
          "docs": "Get a thread"
        },
        {
          "info": {
            "name": "Partially update a thread",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://chat.stream-io-api.com/threads/:message_id",
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path",
                "description": "The parent message id identifying the thread."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Partially update a thread"
        }
      ]
    }
  ],
  "bundled": true
}