{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stream Chat API (Server-side REST) Application Roles API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://chat.stream-io-api.com/roles"
          },
          "docs": "List all roles defined in the application."
        },
        {
          "info": {
            "name": "Create a role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://chat.stream-io-api.com/roles",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a role"
        },
        {
          "info": {
            "name": "Delete a role",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://chat.stream-io-api.com/roles/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a role"
        }
      ]
    }
  ],
  "bundled": true
}